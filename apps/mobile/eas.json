{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:3000",
        "EXPO_PUBLIC_SUPABASE_URL": "SET-IN-EAS-ENVIRONMENT-VARIABLES",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "SET-IN-EAS-ENVIRONMENT-VARIABLES"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "android": { "buildType": "apk" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": { "production": {} }
}