# NationX mobile - public configuration only. Everything with EXPO_PUBLIC_ is compiled INTO the app
# and visible to anyone who unpacks it: never put the Supabase service-role key or any secret here.

# Base URL of the NationX web backend that serves /api/v1 (no trailing slash).
#   Android emulator -> the host machine:  http://10.0.2.2:3000
#   Physical phone on the same Wi-Fi:      http://<your-computer-LAN-IP>:3000
#   Production:                            https://<your-deployed-domain>
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Same Supabase project as the website (Project Settings -> API). The anon key is public by design; RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public website origin used when sharing a shop link (defaults to EXPO_PUBLIC_API_URL).
EXPO_PUBLIC_WEB_URL=