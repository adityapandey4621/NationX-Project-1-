# ==============================================================================
# NationX Foundation — Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env.local for local development.
# NEVER commit real secret keys, service role keys, or database credentials to git!
# ==============================================================================

# Application Base
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="NationX Foundation"
NEXT_PUBLIC_DEFAULT_REGION="Khammam, Telangana"

# Supabase (Public Client Keys - Safe for Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase (Server Service Role Key - STRICTLY CONFIDENTIAL - NEVER EXPOSE TO CLIENT)
# Used only by backend server actions / route handlers for privileged operations
# (e.g., application approval, admin verification, atomic storefront creation)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct Database Connection (For Prisma, Drizzle, or direct migrations if required)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Authentication is provided by Supabase Auth (no separate auth secret needed).
# Configure redirect URLs and email settings in the Supabase dashboard: see docs/SETUP.md.

# Feature Flags (Module Gatekeeping)
NEXT_PUBLIC_FEATURE_GROCERY_ENABLED=false
NEXT_PUBLIC_FEATURE_WHOLESALE_ENABLED=false
NEXT_PUBLIC_FEATURE_SHARED_DELIVERY_ENABLED=false
NEXT_PUBLIC_FEATURE_KHATA_ENABLED=false
NEXT_PUBLIC_FEATURE_WORKFORCE_ENABLED=false
NEXT_PUBLIC_FEATURE_POS_ENABLED=false
NEXT_PUBLIC_FEATURE_VOICE_AGENT_ENABLED=false

# Audit Logging & Telemetry (Optional / Development)
LOG_LEVEL=debug

# API rate limiting (best-effort, per server instance; real protection belongs at the CDN/WAF - see docs/DEPLOYMENT.md)
# Requests per 60 s per client address. Defaults: 240 reads / 60 writes / 20 anonymous request-lookups.
API_RATE_LIMIT_READ=240
API_RATE_LIMIT_WRITE=60
API_RATE_LIMIT_SENSITIVE=20

# Public footer details (optional; a link or line is shown only when set)
# Public origin of the site (used for share links, QR posters and link previews), e.g. https://nationx.example
NEXT_PUBLIC_SITE_URL=
# App downloads shown on /app (leave blank until the builds exist): direct APK link, Play Store and App Store links, all https
NEXT_PUBLIC_ANDROID_APK_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_WHATSAPP=
